.env

# Hochgeladene Dokumente (E-Card, Pass, NADA, Rechte & Pflichten, ...) niemals einchecken
/uploads/*/*
!/uploads/*/.gitkeep

# Protokolldateien
/logs/

# Schlüsseldatei der Verschlüsselung (falls im Anwendungsordner)
/.u19-keys/

# Backups von Datenbereinigungen (enthalten personenbezogene Daten, nie einchecken)
/backups/
